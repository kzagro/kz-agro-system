<!doctype html><html lang="ms"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="theme-color" content="#0b3e2d"><title>KZ Agro | Pengurusan</title><link rel="apple-touch-icon" href="data:image/png;base64,"><style>:root{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#173e2d;background:#f2f6f2}*{box-sizing:border-box}body{margin:0}header{background:#103d2b;color:white;padding:16px;display:flex;align-items:center;gap:12px}header img{width:52px;height:52px;border-radius:13px}header small{display:block;color:#d1e8d9}nav{display:flex;overflow:auto;gap:7px;padding:12px;background:white;position:sticky;top:0;z-index:2;border-bottom:1px solid #ddd}nav button{white-space:nowrap}button{border:0;border-radius:10px;padding:11px 14px;background:#136b48;color:white;font-weight:650;cursor:pointer}button.secondary{background:#e2eee6;color:#145138}button.warn{background:#a54722}button:disabled{opacity:.4}main{max-width:980px;margin:auto;padding:14px 12px 90px}.panel{background:white;border:1px solid #dbe6dd;border-radius:15px;padding:16px;margin-bottom:13px;box-shadow:0 2px 5px #102c1510}.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}h2{margin:0 0 13px}h3{margin:6px 0 12px}label{display:block;font-size:13px;font-weight:650;margin:9px 0 5px}input,select,textarea{width:100%;padding:11px;border:1px solid #b6cdbb;border-radius:9px;font:inherit;background:white}input[type=checkbox]{width:auto}textarea{min-height:70px}.muted{color:#668173;font-size:13px}.pill{border-radius:20px;padding:5px 9px;background:#e4efe7;font-size:12px}.danger{color:#a32e27}.item{border-bottom:1px solid #e5ebe6;padding:12px 0}.item:last-child{border:0}.thumb{width:64px;height:64px;object-fit:cover;border-radius:9px;background:#f1f1f1}.stat{background:#eef6ef;border-radius:12px;padding:12px}.stat strong{font-size:23px;display:block}table{border-collapse:collapse;width:100%;font-size:13px}td,th{padding:9px 5px;border-bottom:1px solid #e2e9e2;text-align:left}th{color:#51715c}.scroll{overflow:auto}.hidden{display:none!important}.notice{background:#fff3d8;border:1px solid #e8c984;padding:12px;border-radius:11px;font-size:13px}.right{text-align:right}@media print{nav,.noprint,button{display:none!important}main{padding:0}.panel{box-shadow:none}}</style></head><body><header><img src="data:image/png;base64,"><div><strong>KZ AGRO</strong><small>Business Management • Versi baharu</small></div></header><nav id="nav"></nav><main id="app"></main><script>
'use strict';
const KEY='kzagro_new_v1';const OUTLETS=['HQ','Station 88','Station 77'];const tabs=[['dashboard','HQ Dashboard'],['products','Produk'],['online','Pesanan Internet'],['pos','Jualan Outlet'],['wholesale','Jualan Borong'],['transfer','Pindahan Stok'],['closing','Closing Outlet'],['runner','Runner'],['public','Katalog Pelanggan'],['backup','Backup']];
const empty=()=>({products:[],sales:[],orders:[],transfers:[],closings:[],runners:[],expenses:[],settings:{whatsapp:'',qrImage:''}});let db;try{db=JSON.parse(localStorage.getItem(KEY))||empty()}catch{db=empty()}for(const k of Object.keys(empty()))if(db[k]===undefined)db[k]=empty()[k];let tab='dashboard';let editId=null;let customerCart={};const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);const $=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const money=v=>'RM '+Number(v||0).toFixed(2);const stamp=()=>new Date().toLocaleString('ms-MY');const today=()=>new Date().toLocaleDateString('en-CA');const save=()=>{localStorage.setItem(KEY,JSON.stringify(db));render()};const opts=(values,selected)=>values.map(x=>`<option value="${esc(x)}" ${x===selected?'selected':''}>${esc(x)}</option>`).join('');const pBy=id=>db.products.find(p=>p.id===id);const name=id=>pBy(id)?.name||'(Produk dipadam)';const hasClosing=(o,d=today())=>db.closings.some(c=>c.outlet===o&&c.day===d);const paid=s=>s.payment!=='Hutang';const stock=(id,outlet)=>{let n=0;for(const p of db.products)if(p.id===id)n+=Number(p.initial?.[outlet]||0);for(const s of db.sales)if(s.productId===id&&s.outlet===outlet)n-=Number(s.qty);for(const t of db.transfers)if(t.productId===id){if(t.from===outlet)n-=Number(t.qty);if(t.to===outlet&&t.status==='Diterima')n+=Number(t.receivedQty)}return Math.round(n*1000)/1000};const productOptions=()=>db.products.filter(p=>p.active).map(p=>`<option value="${p.id}">${esc(p.name)} (${esc(p.unit)})</option>`).join('');const fileData=(file,cb)=>{if(!file)return;if(file.size>1200000){alert('Gambar terlalu besar. Pilih gambar bawah 1.2 MB.');return}const r=new FileReader;r.onload=()=>cb(r.result);r.readAsDataURL(file)};const selectProduct=(id='product')=>`<select id="${id}" required><option value="">Pilih produk</option>${productOptions()}</select>`;const selectOutlet=(id='outlet')=>`<select id="${id}">${opts(OUTLETS)}</select>`;const notify=(s)=>alert(s);
function render(){ $('nav').innerHTML=tabs.map(([id,t])=>`<button class="${tab===id?'':'secondary'}" onclick="go('${id}')">${t}</button>`).join('');let fn=({dashboard:dashboard,products:products,online:online,pos:pos,wholesale:wholesale,transfer:transfer,closing:closing,runner:runner,public:publicCatalog,backup:backup})[tab];$('app').innerHTML=fn();}function go(t){tab=t;editId=null;render();window.scrollTo(0,0)}
function dashboard(){let revenue=db.sales.filter(paid).reduce((a,s)=>a+s.qty*s.price,0);let pending=db.orders.filter(o=>o.status==='Menunggu pengesahan').length;return `<h2>Dashboard HQ</h2><div class="notice">Data versi ini disimpan dalam pelayar/peranti ini sahaja. HQ tidak menerima data telefon outlet lain secara langsung. Bank dan WhatsApp tidak disambung secara automatik.</div><div class="grid" style="margin:12px 0"><div class="stat">Jualan diterima (rekod tempatan)<strong>${money(revenue)}</strong></div><div class="stat">Pesanan online menunggu<strong>${pending}</strong></div><div class="stat">Produk<strong>${db.products.length}</strong></div><div class="stat">Pindahan belum diterima<strong>${db.transfers.filter(t=>t.status!=='Diterima').length}</strong></div></div><div class="panel"><h3>Status Closing Hari Ini (${today()})</h3>${OUTLETS.map(o=>`<div class="item row between"><b>${o}</b><span class="pill">${hasClosing(o)?'Sudah tutup':'Belum tutup'}</span></div>`).join('')}</div><div class="panel"><h3>Ringkasan Jualan Mengikut Saluran</h3>${['Kedai','Borong'].map(ch=>`<div class="item"><b>${ch}</b> ${money(db.sales.filter(s=>s.channel===ch&&paid(s)).reduce((a,s)=>a+s.qty*s.price,0))}</div>`).join('')}<div class="item"><b>Internet (bayaran disahkan manual)</b> ${money(db.orders.filter(o=>o.status==='Bayaran disahkan').reduce((a,o)=>a+o.total,0))}</div></div>`}
function products(){return `<div class="row between"><h2>Pengurusan Produk</h2><button onclick="editProduct(null)">+ Tambah Produk</button></div><div class="notice">Kau tentukan sendiri nama, gambar, harga, unit dan stok awal setiap outlet. Produk baharu akan muncul dalam katalog pada peranti yang sama.</div><div id="productForm"></div><div class="panel">${db.products.length?db.products.map(p=>`<div class="item row"><img class="thumb" src="${p.image||'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E'}"><div style="flex:1;min-width:140px"><b>${esc(p.name)}</b><div class="muted">${esc(p.unit)} • Runcit ${money(p.retail)} • Borong ${money(p.wholesale)} • Min ${p.minWholesale||1}</div><div class="muted">HQ ${stock(p.id,'HQ')} | 88 ${stock(p.id,'Station 88')} | 77 ${stock(p.id,'Station 77')} • ${p.active?'Aktif':'Disembunyikan'}</div></div><button class="secondary" onclick="editProduct('${p.id}')">Ubah</button><button class="warn" onclick="deleteProduct('${p.id}')">Padam</button></div>`).join(''):'Belum ada produk. Tekan + Tambah Produk.'}</div>`}
function editProduct(id){editId=id;let p=pBy(id)||{name:'',unit:'KG',retail:'',wholesale:'',minWholesale:1,image:'',active:true,initial:{}};$('productForm').innerHTML=`<form class="panel" onsubmit="saveProduct(event)"><h3>${id?'Ubah Produk':'Tambah Produk Baharu'}</h3><div class="grid"><div><label>Nama produk *</label><input id="pn" required value="${esc(p.name)}"></div><div><label>Unit</label><select id="pu">${opts(['KG','Biji','Bakul','Kotak','Guni','Tan','Botol','PCS'],p.unit)}</select></div><div><label>Harga runcit RM *</label><input id="pr" type="number" min="0" step="0.01" required value="${esc(p.retail)}"></div><div><label>Harga borong RM</label><input id="pw" type="number" min="0" step="0.01" value="${esc(p.wholesale)}"></div><div><label>Minimum borong</label><input id="pm" type="number" min="1" step="1" value="${p.minWholesale||1}"></div>${OUTLETS.map((o,i)=>`<div><label>Stok awal ${o}</label><input id="pi${i}" type="number" step="0.001" min="0" value="${p.initial?.[o]||0}"></div>`).join('')}</div><label>Gambar produk (maksimum 1.2MB)</label><input type="file" id="pf" accept="image/*"><label><input id="pa" type="checkbox" ${p.active?'checked':''}> Produk aktif</label><p class="muted">Stok awal hanya untuk stok permulaan. Jangan ubah selepas jualan dibuat kecuali membetulkan baki asas.</p><button>Simpan Produk</button> <button type="button" class="secondary" onclick="render()">Batal</button></form>`;window.scrollTo(0,0)}
function saveProduct(e){e.preventDefault();let existing=pBy(editId);let obj={id:editId||uid(),name:$('pn').value.trim(),unit:$('pu').value,retail:Number($('pr').value),wholesale:Number($('pw').value||0),minWholesale:Number($('pm').value||1),active:$('pa').checked,initial:Object.fromEntries(OUTLETS.map((o,i)=>[o,Number($('pi'+i).value||0)])),image:existing?.image||''};const done=()=>{if(existing)Object.assign(existing,obj);else db.products.push(obj);editId=null;save()};let f=$('pf').files[0];if(f)fileData(f,d=>{obj.image=d;done()});else done()}
function deleteProduct(id){if(db.sales.some(s=>s.productId===id)||db.transfers.some(t=>t.productId===id)){alert('Produk sudah ada transaksi. Gunakan Ubah > nyahaktif supaya sejarah kekal.');return}if(confirm('Padam produk ini?')){db.products=db.products.filter(p=>p.id!==id);save()}}
function pos(){return salePage('Kedai')}function wholesale(){return salePage('Borong')}
function salePage(channel){let rows=db.sales.filter(s=>s.channel===channel);return `<h2>Jualan ${channel==='Kedai'?'Kedai Setiap Outlet':'Borong'}</h2><div class="panel"><h3>Rekod Jualan ${channel}</h3><form onsubmit="saveSale(event,'${channel}')"><div class="grid"><div><label>Outlet</label>${selectOutlet()}</div><div><label>Produk</label>${selectProduct()}</div><div><label>Kuantiti</label><input id="qty" type="number" min="0.001" step="0.001" required></div><div><label>Harga seunit (RM)</label><input id="price" type="number" min="0" step="0.01" required></div><div><label>Bayaran</label><select id="payment">${opts(['Tunai','QR','Transfer','Hutang'])}</select></div><div><label>Reference ID (jika QR/Transfer)</label><input id="reference"></div><div><label>Nama pelanggan (pilihan)</label><input id="customer"></div></div><p class="muted">Harga seunit boleh diubah mengikut transaksi. Jualan ditolak daripada stok outlet dipilih.</p><button>Simpan Jualan</button></form></div>${OUTLETS.map(o=>`<div class="panel"><h3>${o}</h3><div class="muted">Jumlah kutipan ${money(rows.filter(s=>s.outlet===o&&paid(s)).reduce((a,s)=>a+s.qty*s.price,0))}</div><div class="scroll"><table><tr><th>Masa</th><th>Produk</th><th>Qty</th><th>Bayaran</th><th>Jumlah</th></tr>${rows.filter(s=>s.outlet===o).slice().reverse().map(s=>`<tr><td>${esc(s.time)}</td><td>${esc(name(s.productId))}</td><td>${s.qty}</td><td>${esc(s.payment)}</td><td>${money(s.qty*s.price)}</td></tr>`).join('')}</table></div></div>`).join('')}`}
function saveSale(e,channel){e.preventDefault();let o=$('outlet').value,p=$('product').value,q=Number($('qty').value),price=Number($('price').value);if(hasClosing(o)){alert('Outlet sudah closing hari ini. Jualan baharu disekat.');return}if(!p||q<=0||stock(p,o)<q){alert('Produk tiada atau stok outlet tidak cukup.');return}db.sales.push({id:uid(),channel,outlet:o,productId:p,qty:q,price,payment:$('payment').value,reference:$('reference').value.trim(),customer:$('customer').value.trim(),day:today(),time:stamp()});save()}
function online(){return `<h2>Pesanan Internet</h2><div class="notice">Pelanggan di telefon lain belum boleh menghantar pesanan atau resit terus ke HQ. Borang ini untuk rekod manual dan pengesahan oleh HQ. Resit bukan bukti duit sudah diterima.</div><div class="panel"><h3>Daftar Pesanan Internet</h3><form onsubmit="saveOrder(event)"><div class="grid"><div><label>Nama pelanggan</label><input id="cn" required></div><div><label>No. WhatsApp</label><input id="cp" required></div><div><label>Outlet pemenuhan</label>${selectOutlet()}</div><div><label>Produk</label>${selectProduct()}</div><div><label>Kuantiti</label><input id="qty" type="number" step="0.001" min="0.001" required></div><div><label>Harga seunit RM</label><input id="price" type="number" step="0.01" min="0" required></div><div><label>Caj penghantaran RM</label><input id="delivery" type="number" step="0.01" min="0" value="0" required></div><div><label>Kaedah bayaran</label><select id="payment">${opts(['DuitNow QR / TNG','Transfer Bank'])}</select></div><div><label>Reference ID wajib</label><input id="reference" required></div><div><label>Resit (pilihan, maks 1.2MB)</label><input type="file" accept="image/*" id="receipt"></div></div><label>Alamat penghantaran</label><textarea id="address" required></textarea><button>Rekod Pesanan (Belum Disahkan)</button></form></div><div class="panel"><h3>Semakan HQ</h3>${db.orders.slice().reverse().map(o=>`<div class="item"><div class="row between"><b>${esc(o.code)} • ${esc(o.customer)}</b><span class="pill">${esc(o.status)}</span></div><div class="muted">${esc(o.outlet)} • ${esc(name(o.productId))} × ${o.qty} • ${money(o.total)} • ${esc(o.payment)} • Ref: ${esc(o.reference)}</div><div class="muted">${esc(o.address)} • ${esc(o.phone)}</div><div class="row" style="margin-top:9px">${o.receipt?`<button class="secondary" onclick="viewReceipt('${o.id}')">Lihat Resit</button>`:''}${o.status==='Menunggu pengesahan'?`<button onclick="verifyOrder('${o.id}')">Sahkan Selepas Semak Bank</button>`:''}<button class="secondary" onclick="updateOrder('${o.id}')">Ubah Status</button></div></div>`).join('')||'Belum ada pesanan.'}</div>`}
function saveOrder(e){e.preventDefault();let f=$('receipt').files[0];let p=$('product').value,q=Number($('qty').value),price=Number($('price').value),d=Number($('delivery').value);if(!p)return alert('Pilih produk');let o={id:uid(),code:'KZ-'+Date.now().toString().slice(-8),customer:$('cn').value,phone:$('cp').value,outlet:$('outlet').value,productId:p,qty:q,price,delivery:d,total:q*price+d,payment:$('payment').value,reference:$('reference').value.trim(),address:$('address').value,receipt:'',status:'Menunggu pengesahan',time:stamp()};if(db.orders.some(x=>x.reference===o.reference)){alert('Reference ID sudah digunakan. Sila semak.');return}const done=()=>{db.orders.push(o);save()};if(f)fileData(f,d=>{o.receipt=d;done()});else done()}
function viewReceipt(id){let o=db.orders.find(x=>x.id===id);if(o?.receipt){let w=window.open();if(w)w.document.write(`<img style="max-width:100%" src="${o.receipt}">`);else alert('Benarkan pop-up untuk lihat resit')}}function verifyOrder(id){let o=db.orders.find(x=>x.id===id);if(confirm('Sudah SEMAK transaksi sebenar dalam akaun bank, jumlah '+money(o.total)+' dan Reference ID '+o.reference+'?')){o.status='Bayaran disahkan';o.verifiedBy=prompt('Nama pegawai HQ yang semak:')||'HQ';o.verifiedAt=stamp();save()}}function updateOrder(id){let o=db.orders.find(x=>x.id===id);let a=prompt('Status: Menunggu pengesahan / Bayaran disahkan / Diproses / Dalam penghantaran / Diterima / Batal',o.status);if(['Menunggu pengesahan','Bayaran disahkan','Diproses','Dalam penghantaran','Diterima','Batal'].includes(a)){o.status=a;save()}}
function transfer(){return `<h2>Pindahan & Penerimaan Stok</h2><div class="panel"><h3>Hantar Stok Antara Outlet</h3><form onsubmit="sendTransfer(event)"><div class="grid"><div><label>Dari</label><select id="from">${opts(OUTLETS)}</select></div><div><label>Ke</label><select id="to">${opts(OUTLETS,'Station 88')}</select></div><div><label>Produk</label>${selectProduct()}</div><div><label>Kuantiti dihantar</label><input id="qty" type="number" min="0.001" step="0.001" required></div><div><label>Pemandu</label><input id="driver"></div></div><button>Rekod Barang Keluar</button></form></div><div class="panel"><h3>Status Penerimaan</h3>${db.transfers.slice().reverse().map(t=>`<div class="item"><b>${esc(t.from)} → ${esc(t.to)}</b> <span class="pill">${esc(t.status)}</span><div class="muted">${esc(name(t.productId))} • Hantar ${t.qty} • Terima ${t.receivedQty??'-'} • ${esc(t.time)}</div>${t.status!=='Diterima'?`<button onclick="receiveTransfer('${t.id}')">Sahkan Penerimaan</button>`:`<div class="muted">Diterima oleh ${esc(t.receiver)} pada ${esc(t.receivedAt)} • Beza ${t.qty-t.receivedQty}</div>`}</div>`).join('')||'Belum ada pindahan.'}</div>`}
function sendTransfer(e){e.preventDefault();let f=$('from').value,t=$('to').value,p=$('product').value,q=Number($('qty').value);if(f===t||!p||q<=0||stock(p,f)<q)return alert('Semak outlet dan stok.');db.transfers.push({id:uid(),from:f,to:t,productId:p,qty:q,driver:$('driver').value,status:'Dalam perjalanan',time:stamp()});save()}
function receiveTransfer(id){let t=db.transfers.find(x=>x.id===id);let n=Number(prompt('Kuantiti sebenar diterima:',t.qty));if(!Number.isFinite(n)||n<0||n>t.qty)return alert('Kuantiti tidak sah');let who=prompt('Nama penerima:');if(!who)return; t.receivedQty=n;t.receiver=who;t.receivedAt=stamp();t.status='Diterima';save()}
function closing(){return `<h2>Closing Sales Outlet</h2><div class="notice">Status closing hanya dapat dilihat pada peranti ini. Untuk HQ semak closing telefon outlet lain secara langsung, perlu pangkalan data online.</div><div class="panel"><h3>Tutup Jualan Hari Ini</h3><form onsubmit="closeOutlet(event)"><label>Outlet</label>${selectOutlet()}<label>Nama pekerja</label><input id="worker" required><label>Jumlah tunai sebenar dalam laci (RM)</label><input id="cash" type="number" min="0" step="0.01" required><button style="margin-top:12px">Tutup Jualan</button></form></div>${OUTLETS.map(o=>{let s=db.sales.filter(x=>x.outlet===o&&x.day===today());let by=p=>s.filter(x=>x.payment===p).reduce((a,x)=>a+x.qty*x.price,0);let c=db.closings.find(x=>x.outlet===o&&x.day===today());return `<div class="panel"><div class="row between"><h3>${o}</h3><span class="pill">${c?'Sudah tutup':'Belum tutup'}</span></div><div>Tunai ${money(by('Tunai'))} • QR ${money(by('QR'))} • Transfer ${money(by('Transfer'))} • Hutang ${money(by('Hutang'))}</div>${c?`<p class="muted">${esc(c.worker)} • ${esc(c.time)} • Tunai dikira ${money(c.cash)} • Beza ${money(c.cash-c.expectedCash)}</p><button class="secondary" onclick="window.print()">Cetak Laporan</button>`:''}</div>`}).join('')}`}
function closeOutlet(e){e.preventDefault();let o=$('outlet').value;if(hasClosing(o))return alert('Outlet sudah tutup hari ini');let expected=db.sales.filter(x=>x.outlet===o&&x.day===today()&&x.payment==='Tunai').reduce((a,x)=>a+x.qty*x.price,0);if(!confirm('Tutup jualan '+o+'? Transaksi baharu hari ini akan disekat.'))return;db.closings.push({id:uid(),outlet:o,day:today(),worker:$('worker').value,cash:Number($('cash').value),expectedCash:expected,time:stamp()});save()}
function runner(){return `<h2>Senarai Runner & WhatsApp</h2><div class="panel"><form onsubmit="addRunner(event)"><div class="grid"><div><label>Nama runner</label><input id="rn" required></div><div><label>Nombor WhatsApp (60...)</label><input id="rp" required></div><div><label>Kawasan liputan</label><input id="ra" required></div></div><button style="margin-top:12px">Tambah Runner</button></form></div><div class="panel">${db.runners.map(r=>`<div class="item row between"><div><b>${esc(r.name)}</b><div class="muted">${esc(r.phone)} • ${esc(r.area)}</div></div><div class="row"><button onclick="waRunner('${r.id}')">WhatsApp</button><button class="warn" onclick="delRunner('${r.id}')">Padam</button></div></div>`).join('')||'Belum ada runner.'}</div>`}
function addRunner(e){e.preventDefault();db.runners.push({id:uid(),name:$('rn').value,phone:$('rp').value,area:$('ra').value});save()}function delRunner(id){if(confirm('Padam runner?')){db.runners=db.runners.filter(r=>r.id!==id);save()}}function waRunner(id){let r=db.runners.find(x=>x.id===id);let phone=r.phone.replace(/\D/g,'');window.open('https://wa.me/'+phone+'?text='+encodeURIComponent('Salam, saya dari KZ Agro. Ada penghantaran untuk kawasan '+r.area+'. Boleh ambil tugasan?'),'_blank')}
function publicCatalog(){let items=db.products.filter(p=>p.active&&OUTLETS.some(o=>stock(p.id,o)>0));return `<h2>Katalog Pelanggan (Pratonton)</h2><div class="notice">Ini pratonton katalog pada peranti ini. Tempahan pelanggan daripada peranti lain belum masuk automatik ke HQ. Hanya produk aktif dengan stok ditunjukkan.</div><div class="panel"><h3>Senarai Produk</h3>${items.map(p=>`<div class="item row"><img class="thumb" src="${p.image||'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22/%3E'}"><div style="flex:1"><b>${esc(p.name)}</b><div class="muted">${money(p.retail)} / ${esc(p.unit)}</div></div><div style="width:95px"><label>Kuantiti</label><input type="number" id="cart_${p.id}" min="0" step="1" value="${customerCart[p.id]||0}" onchange="customerCart['${p.id}']=Number(this.value)"></div></div>`).join('')||'Belum ada produk aktif dengan stok.'}<button onclick="cartWhatsApp()">Hantar Pesanan Melalui WhatsApp</button></div>`}
function cartWhatsApp(){let lines=Object.entries(customerCart).filter(([id,q])=>q>0&&pBy(id));if(!lines.length)return alert('Pilih kuantiti');let total=lines.reduce((a,[id,q])=>a+pBy(id).retail*q,0);let msg='Tempahan KZ Agro%0A'+lines.map(([id,q])=>name(id)+' x '+q+' = '+money(pBy(id).retail*q)).join('\n')+'\nJumlah produk: '+money(total)+'\nCaj penghantaran akan disahkan.';let w=db.settings.whatsapp.replace(/\D/g,'');if(!w)return alert('Masukkan nombor WhatsApp HQ dalam Backup & Tetapan dahulu');window.open('https://wa.me/'+w+'?text='+encodeURIComponent(decodeURIComponent(msg)),'_blank')}
function backup(){return `<h2>Backup & Tetapan</h2><div class="panel"><label>Nombor WhatsApp HQ (60...)</label><input id="hqwa" value="${esc(db.settings.whatsapp)}"><button style="margin-top:10px" onclick="db.settings.whatsapp=$('hqwa').value;save()">Simpan Nombor</button></div><div class="panel"><h3>Keselamatan Data</h3><p class="muted">Data disimpan dalam localStorage Safari. Padam data Safari atau tukar peranti boleh menghilangkan rekod. Export backup secara berkala.</p><button onclick="exportData()">Muat Turun Backup JSON</button><label>Import Backup JSON</label><input type="file" id="import" accept="application/json,.json"><button class="secondary" style="margin-top:10px" onclick="importData()">Import Backup</button></div><div class="panel"><h3>Batasan Versi Ini</h3><p>Belum ada log masuk pekerja sebenar, database online, pengesahan bank automatik, resit pelanggan merentas telefon atau sambungan terus ke printer Bluetooth. Cetakan boleh melalui fungsi Print iPhone jika printer menyokong AirPrint.</p></div>`}
function exportData(){let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(db,null,2)],{type:'application/json'}));a.download='KZ_AGRO_BACKUP_'+today()+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),5000)}function importData(){let f=$('import').files[0];if(!f)return alert('Pilih fail JSON');let r=new FileReader;r.onload=()=>{try{let d=JSON.parse(r.result);if(!Array.isArray(d.products)||!Array.isArray(d.sales))throw Error();if(confirm('Ganti semua data versi baharu dengan backup ini?')){db=d;save()}}catch{alert('Fail backup tidak sah')}};r.readAsText(f)}
render();</script></body></html>